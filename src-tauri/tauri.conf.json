{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OCEAN Lightning",
  "version": "0.3.0",
  "identifier": "xyz.oceanln.desktop",
  "build": {
    "frontendDist": "../oceanln-web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../oceanln-web run dev",
    "beforeBuildCommand": "npm --prefix ../oceanln-web run build"
  },
  "app": {
    "windows": [
      {
        "title": "OCEAN Lightning",
        "width": 1100,
        "height": 820,
        "minWidth": 880,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
